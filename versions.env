# Single source of truth for the toolchain. Sourced by build/lib.sh, the Makefile and CI.
# Target stack: rollups-node v2.0.0-alpha.13, rollups-contracts v3.0.0-alpha.10,
# emulator 0.21.0, machine-guest-tools 0.18.0.

# rollups-node source (cloned at build time, commit checked)
NODE_REPO=https://github.com/cartesi/rollups-node.git
NODE_TAG=v2.0.0-alpha.13
NODE_COMMIT=36155487d8bcb1daca5d683b8fa4ec65feba3ab7

# Builder image = the node's own Dockerfile, stage go-prepare, built from the clone above:
# debian trixie + cartesi-machine 0.21.0 (.deb, sha256-pinned in that Dockerfile) + Go 1.27.1 (sha256-pinned)
# + the node's Go module cache. Snapshots and fixtures are all produced inside it.
BUILDER_TARGET=go-prepare
BUILDER_IMAGE=qa-apps-builder:36155487
EMULATOR_VERSION=0.21.0

# Machine images (URLs = test/dependencies of the tag; sha256 = test/dependencies.sha256 of the tag;
# the build re-checks both against the clone)
KERNEL_FILE=linux-6.5.13-ctsi-2-v0.21.0.bin
KERNEL_URL=https://github.com/cartesi/machine-linux-image/releases/download/v0.21.0/linux-6.5.13-ctsi-2-v0.21.0.bin
KERNEL_SHA256=5c900060da2db2bfa84cd39cd9cd722988c83c42225f3cac55f2d3157e48f32f
ROOTFS_FILE=rootfs-tools.ext2
ROOTFS_URL=https://github.com/cartesi/machine-guest-tools/releases/download/v0.18.0/rootfs-tools.ext2
ROOTFS_SHA256=6c159937485c99f695021c4f2ea2a57bdadcf4e4bce8e71af5bee3bb9552802e

# foreclose-app/install.sh must stay byte-identical to test/dapps/erc20-withdrawal/install.sh at NODE_COMMIT
INSTALL_SH_SHA256=c0a6a2069f08e2fc46957bbbbd9b53d03921d37e42fdf36f68f8c34c31fca495

# Contracts (rollups-contracts v3.0.0-alpha.10; same addresses on devnet, Sepolia, Base Sepolia, OP Sepolia)
CONTRACTS_VERSION=3.0.0-alpha.10
